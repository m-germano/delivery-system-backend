# =============================================================================
# APP
# =============================================================================

APP_NAME=Delivery System API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api


# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=postgresql+asyncpg://postgres:marcal2012@localhost:5432/delivery_system
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true
VERIFY_TABLES_ON_STARTUP=true


# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=redis://localhost:6379/0


# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://fifty-eagle-unearned.ngrok-free.dev"]


# =============================================================================
# AUTH / JWT
# =============================================================================

SECRET_KEY="COLE_AQUI_UM_SECRET_KEY_NOVO"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256


# =============================================================================
# EXTERNAL APIS
# =============================================================================

VIACEP_BASE_URL=https://viacep.com.br/ws
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
USE_REAL_ROUTE_DISTANCE=true
GEOCODING_USER_AGENT=DeliverySystemAPI/0.1.0
NOMINATIM_EMAIL=
EXTERNAL_API_TIMEOUT_SECONDS=8


# =============================================================================
# CRYPTO
# =============================================================================

# Gera com:
# Linux: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Windows: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=COLE_AQUI_UM_TOKEN_ENCRYPTION_KEY_NOVO


# =============================================================================
# MERCADO PAGO - PRODUÇÃO CONTROLADA VIA NGROK
# =============================================================================

BACKEND_PUBLIC_URL={GROK_URL}

# IMPORTANTE:
# Neste backend, o pagamento usa OAuth por empresa/restaurante.
# Portanto, não coloque MERCADO_PAGO_ACCESS_TOKEN global no .env para o fluxo normal.
# Primeiro conecte a conta na tela da empresa; o backend salvará o token criptografado no banco.

MERCADO_PAGO_CLIENT_ID={CLIENT_ID}
MERCADO_PAGO_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET_ROTACIONADO
MERCADO_PAGO_USE_PKCE=true

MERCADO_PAGO_REDIRECT_URI={GROK_URL}/api/payment-accounts/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_URL={GROK_URL}/api/payments/mercado-pago/webhook

MERCADO_PAGO_OAUTH_AUTHORIZE_URL=https://auth.mercadopago.com.br/authorization
MERCADO_PAGO_OAUTH_TOKEN_URL=https://api.mercadopago.com/oauth/token
MERCADO_PAGO_PAYMENTS_URL=https://api.mercadopago.com/v1/payments

MERCADO_PAGO_WEBHOOK_SECRET=COLE_AQUI_A_ASSINATURA_SECRETA_DO_WEBHOOK
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=600
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30


# =============================================================================
# FRONTEND CALLBACKS
# =============================================================================


FRONTEND_MERCADO_PAGO_ERROR_URL=http://localhost:5173/company/mercado-pago?connected=false


MERCADO_PAGO_CHECKOUT_PREFERENCES_URL=https://api.mercadopago.com/checkout/preferences

MERCADO_PAGO_CHECKOUT_SUCCESS_URL={GROK_URL}/api/payments/mercado-pago/checkout-return?order_id={order_id}&mp_result=success
MERCADO_PAGO_CHECKOUT_FAILURE_URL={GROK_URL}/api/payments/mercado-pago/checkout-return?order_id={order_id}&mp_result=failure
MERCADO_PAGO_CHECKOUT_PENDING_URL={GROK_URL}/api/payments/mercado-pago/checkout-return?order_id={order_id}&mp_result=pending