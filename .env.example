APP_NAME=Delivery System API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api

# Banco de dados
# Se estiver usando Docker Compose, normalmente use o host "postgres":
# DATABASE_URL=postgresql+asyncpg://delivery_user:delivery_pass@postgres:5432/delivery_db
# Se estiver rodando a API fora do Docker e o banco localmente:
# DATABASE_URL=postgresql+asyncpg://delivery_user:delivery_pass@localhost:5432/delivery_db
DATABASE_URL=postgresql+asyncpg://delivery_user:delivery_pass@postgres:5432/delivery_db
DATABASE_ECHO=false

# Redis
# Com Docker Compose, normalmente use o host "redis":
REDIS_URL=redis://redis:6379/0

# Inicialização/verificação de tabelas
AUTO_CREATE_TABLES=true
VERIFY_TABLES_ON_STARTUP=true

# CORS
# O config espera uma lista JSON.
# Desenvolvimento aberto:
# CORS_ORIGINS=["*"]
# Desenvolvimento restrito:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000"]
CORS_ORIGINS=["*"]

# JWT
# Use uma chave forte, com mais de 32 caracteres.
SECRET_KEY=troque-esta-chave-por-uma-chave-forte-com-mais-de-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# Criptografia de tokens sensíveis
# Gere com:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Mercado Pago OAuth / Pix / Webhook
# Crie uma aplicação no Mercado Pago Developers e preencha CLIENT_ID e CLIENT_SECRET.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_USE_PKCE=true

# Em ambiente local, o Mercado Pago exige URL HTTPS.
# Use ngrok:
# ngrok http 8000
# Exemplo:
# MERCADO_PAGO_REDIRECT_URI=https://sua-url.ngrok-free.dev/api/payment-accounts/mercado-pago/callback
MERCADO_PAGO_REDIRECT_URI=http://localhost:8000/api/payment-accounts/mercado-pago/callback

MERCADO_PAGO_OAUTH_AUTHORIZE_URL=https://auth.mercadopago.com.br/authorization
MERCADO_PAGO_OAUTH_TOKEN_URL=https://api.mercadopago.com/oauth/token
MERCADO_PAGO_PAYMENTS_URL=https://api.mercadopago.com/v1/payments

# URL pública que o Mercado Pago chamará quando o pagamento mudar de status.
# Exemplo com ngrok:
# MERCADO_PAGO_WEBHOOK_URL=https://sua-url.ngrok-free.dev/api/payments/mercado-pago/webhook
MERCADO_PAGO_WEBHOOK_URL=

# Assinatura secreta gerada no portal do Mercado Pago para validar webhooks.
# Não é obrigatória para testes iniciais, mas é recomendada.
MERCADO_PAGO_WEBHOOK_SECRET=

# Tempo de expiração do Pix em minutos.
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30

# URLs do frontend para retorno do OAuth Mercado Pago.
FRONTEND_MERCADO_PAGO_SUCCESS_URL=http://localhost:5173/company/mercado-pago?connected=true
FRONTEND_MERCADO_PAGO_ERROR_URL=http://localhost:5173/company/mercado-pago?connected=false

# APIs externas de endereço/geocodificação
VIACEP_BASE_URL=https://viacep.com.br/ws
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=DeliverySystemAPI/0.1.0
NOMINATIM_EMAIL=
EXTERNAL_API_TIMEOUT_SECONDS=8

# Rotas/distância
# Se existir suporte no projeto, habilita cálculo por ruas via OSRM.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTE_DISTANCE_OSRM_ENABLED=true
ROUTE_DISTANCE_TIMEOUT_SECONDS=6
